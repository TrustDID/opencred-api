# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# TODO (contributor): Uncomment when PostgreSQL issue is resolved.
# ──────────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=opencred
# DB_PASSWORD=changeme
# DB_NAME=opencred_dev
# DB_SSL=false

# ──────────────────────────────────────────────
# Stellar / Soroban
# ──────────────────────────────────────────────
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# TODO (contributor): Add contract addresses once Soroban contracts are deployed.
# CREDENTIAL_CONTRACT_ID=
# VERIFICATION_CONTRACT_ID=

# ──────────────────────────────────────────────
# IPFS
# ──────────────────────────────────────────────
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# TODO (contributor): Add API credentials for your chosen pinning service.
# IPFS_API_URL=
# IPFS_API_KEY=

# ──────────────────────────────────────────────
# JWT
# TODO (contributor): Set strong secrets in production. Never commit real values.
# ──────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# TODO (contributor): Add when refresh tokens are implemented.
# JWT_REFRESH_SECRET=replace_with_another_long_random_secret
# JWT_REFRESH_EXPIRES_IN=7d
